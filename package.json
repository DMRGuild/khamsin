{
  "name": "khamsin",
  "private": true,
  "type": "module",
  "scripts": {
    "build:templates": "node scripts/build-templates.mjs",
    "check": "tsc --noEmit",
    "build": "node scripts/ensure-wrangler.mjs --example && wrangler deploy --dry-run --outdir dist",
    "dev": "node scripts/ensure-wrangler.mjs && wrangler dev",
    "deploy": "node scripts/check-deploy.mjs && wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "seed:local": "node scripts/seed-kv.mjs --local",
    "seed:remote": "node scripts/seed-kv.mjs --remote",
    "upload:wasm": "node scripts/upload-wasm.mjs",
    "build:node": "node scripts/build-node.mjs",
    "start": "node --env-file-if-exists=.env dist/node.mjs",
    "config:import": "node scripts/config.mjs import",
    "config:export": "node scripts/config.mjs export",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "eta": "^4.6.0",
    "hono": "^4.13.5",
    "iron-session": "^8.0.4",
    "nostr-tools": "^2.25.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250903.0",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260426.0",
    "smol-toml": "^1.8.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "version": "0.1.0",
  "description": "A standalone browser-first document archive on Cloudflare Workers",
  "engines": {
    "node": ">=22.13"
  }
}
