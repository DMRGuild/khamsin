{
  "name": "khamsin",
  "private": true,
  "type": "module",
  "scripts": {
    "build:templates": "node scripts/build-templates.mjs",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "node scripts/check-deploy.mjs && wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "seed:local": "node scripts/seed-kv.mjs --local",
    "seed:remote": "node scripts/seed-kv.mjs --remote",
    "upload:wasm": "node scripts/upload-wasm.mjs"
  },
  "dependencies": {
    "eta": "^4.6.0",
    "hono": "^4.13.5",
    "iron-session": "^8.0.4",
    "nostr-tools": "^2.25.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250903.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "version": "0.1.0",
  "description": "A standalone browser-first document archive on Cloudflare Workers",
  "engines": {
    "node": ">=22"
  }
}
